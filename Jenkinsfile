pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Hello World'
                echo 'Welcome to Jenkins'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing the application'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Application deployed successfully'
            }
        }
    }
}
